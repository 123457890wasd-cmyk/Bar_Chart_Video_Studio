# 后端配置（复制为 .env 后修改）
# 说明：不设置 PORT 时，npm run dev 会先跑 pick-port.mjs 自动探测可用端口
# 并写入 data/backend.port（Windows 动态端口排除区间会随重启漂移，写死端口不可靠）。
# vite 代理与 e2e 测试脚本都读 data/backend.port 对齐。
PORT=
HOST=127.0.0.1

# AI 增强（二期，默认 DeepSeek · OpenAI 兼容协议）
# 仅存后端，绝不打进前端包（方案 §3.7 / §11-5）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
