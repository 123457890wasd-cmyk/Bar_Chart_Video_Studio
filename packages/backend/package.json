{
  "name": "@barstudio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "predev": "node scripts/pick-port.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:better-sqlite3 --external:@fastify/multipart --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "stop": "node scripts/manage.mjs stop",
    "status": "node scripts/manage.mjs status",
    "kill": "node scripts/manage.mjs kill"
  },
  "dependencies": {
    "@barstudio/shared": "*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.1",
    "papaparse": "^5.5.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.3.15",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  }
}
